/* 全局样式 */
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

button {
  border: none;
  outline: none;
  cursor: pointer;
}

input {
  outline: none;
  border: none;
}

/* 通用样式类 */
.container {
  width: 100%;
  height: 100vh;
}

.title {
  font-size: 24px;
  font-weight: bold;
  color: #333;
}

.section {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.section-title {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

/* 按钮样式 */
.btn-primary {
  padding: 20rpx;
  background-color: #1890ff;
  color: #fff;
  font-size: 16px;
  font-weight: bold;
  border-radius: 8rpx;
  border: none;
}

.btn-danger {
  padding: 20rpx;
  background-color: #ff4d4f;
  color: #fff;
  font-size: 16px;
  font-weight: bold;
  border-radius: 8rpx;
  border: none;
}

/* 输入框样式 */
.input {
  padding: 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 16px;
  background-color: #fff;
}

/* 列表项样式 */
.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  background-color: #f9f9f9;
  margin-bottom: 10rpx;
}

/* 空状态样式 */
.empty {
  padding: 40rpx;
  text-align: center;
  color: #999;
  font-size: 16px;
}

/* 加载状态样式 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
}

/* 提示框样式 */
.toast {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  padding: 20rpx;
  background-color: rgba(0, 0, 0, 0.7);
  color: #fff;
  border-radius: 8rpx;
  font-size: 16px;
  z-index: 9999;
}