.container {
  height: 100vh;
  background-color: #f5f5f5;
}

.header {
  padding: 20rpx;
  background-color: #fff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title {
  font-size: 20px;
  font-weight: bold;
  color: #333;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.logout-btn {
  padding: 10rpx 20rpx;
  background-color: #ff4d4f;
  color: #fff;
  font-size: 14px;
  border-radius: 4rpx;
  border: none;
}

.content {
  padding: 20rpx;
}

.section {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.section-title {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

.nav-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  background-color: #f9f9f9;
  cursor: pointer;
  transition: all 0.3s ease;
}

.nav-item:hover {
  transform: translateY(-5rpx);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
}

.nav-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 15rpx;
}

.nav-icon image {
  width: 100%;
  height: 100%;
}

.nav-name {
  font-size: 16px;
  color: #333;
  font-weight: 500;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.order-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  background-color: #f9f9f9;
}

.order-info {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.order-id {
  font-size: 16px;
  font-weight: 500;
  color: #333;
}

.order-time {
  font-size: 14px;
  color: #666;
}

.order-status {
  font-size: 14px;
  color: #1890ff;
  font-weight: 500;
}

.empty {
  padding: 40rpx;
  text-align: center;
  color: #999;
  font-size: 16px;
}