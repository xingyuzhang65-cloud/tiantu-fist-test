.container {
  height: 100vh;
  background-color: #f5f5f5;
}

.header {
  padding: 20rpx;
  background-color: #fff;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title {
  font-size: 20px;
  font-weight: bold;
  color: #333;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.logout-btn {
  padding: 10rpx 20rpx;
  background-color: #ff4d4f;
  color: #fff;
  font-size: 14px;
  border-radius: 4rpx;
  border: none;
}

.content {
  padding: 20rpx;
}

.section {
  background-color: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.section-title {
  font-size: 18px;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

.queue-list {
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.queue-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  background-color: #f9f9f9;
}

.queue-info {
  display: flex;
  flex-direction: column;
  gap: 5rpx;
}

.queue-name {
  font-size: 16px;
  font-weight: 500;
  color: #333;
}

.queue-number {
  font-size: 14px;
  color: #666;
}

.queue-status {
  font-size: 14px;
  color: #1890ff;
  font-weight: 500;
}

.empty {
  padding: 40rpx;
  text-align: center;
  color: #999;
  font-size: 16px;
}