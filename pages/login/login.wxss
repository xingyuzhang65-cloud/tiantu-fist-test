.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
  background-color: #f5f5f5;
}

.title {
  font-size: 24px;
  font-weight: bold;
  margin-bottom: 60rpx;
  color: #333;
}

.form {
  width: 80%;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.form-item {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.label {
  font-size: 16px;
  color: #333;
  font-weight: 500;
}

.input {
  padding: 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 16px;
  background-color: #fff;
}

.login-btn {
  margin-top: 40rpx;
  padding: 20rpx;
  background-color: #1890ff;
  color: #fff;
  font-size: 16px;
  font-weight: bold;
  border-radius: 8rpx;
  border: none;
}

.login-btn:hover {
  background-color: #40a9ff;
}